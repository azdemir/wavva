# ⚠️  WARNING: this file is tracked in git with PLACEHOLDER values only.
# Fill in your real keys in YOUR LOCAL COPY ONLY.
# NEVER commit or push this file after filling in real secrets —
# secrets pushed to GitHub are compromised forever and must be rotated.
# For the live (Vercel) deployment, paste keys into Vercel's
# Project Settings → Environment Variables instead.
#
# --- App ---
# Public URL of the app (used for invite links and auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stage 3: Supabase (PostgreSQL + Auth) ---
# From https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only, bypasses RLS. Used only for invite-token lookup.
SUPABASE_SERVICE_ROLE_KEY=
#
# One-time setup in the Supabase dashboard:
# 1. Run supabase/migrations/0001_init.sql in the SQL editor (or `supabase db push`).
# 2. Auth → Sign In / Sign Up: enable Email provider.
#    For local development, disable "Confirm email" so sign-up signs users in immediately.

# --- Stage 5: Object storage (logos, job photos) ---
# S3-compatible storage credentials (Supabase Storage, Cloudflare R2, or AWS S3).
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Stage 6: Stripe — platform subscriptions (test mode keys) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for Starter / Growth / Pro (created in the Stripe dashboard)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# --- Stage 6: Stripe Connect — customer payments to cleaning companies ---
# Connect is configured in the Stripe dashboard; webhook secret above covers Connect events.

# --- Stage 7: Email notifications ---
RESEND_API_KEY=
EMAIL_FROM="TidyPro <hello@tidypro.example>"
# Bearer token protecting /api/cron/notifications (daily queue drain + reminders).
CRON_SECRET=

# --- Stage 7: Platform admin ---
# Comma-separated emails allowed into /admin (TidyPro operators, not company users).
PLATFORM_ADMIN_EMAILS=

# --- Stage 7: SMS notifications (Twilio, consent-first) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
